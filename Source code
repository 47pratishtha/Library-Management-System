def add_book():

    ch=int(input("enter the no. of entries you want to add:"))
    for i in range(ch):
        bid = int(input("Enter Book ID: "))
        title = input("Enter Book Title: ")
        author = input("Enter Author: ")
        genre = input("Enter Genre: ")
        total = int(input("Enter Total Copies: "))
        avail = int(input("Enter Available Copies: "))
        shelf = input("Enter Shelf Location: ")
        mycur.execute("INSERT INTO books_details VALUES(%s,%s,%s,%s,%s,%s,%s)",
                (bid, title, author, genre, total, avail, shelf))
        print("-"*20)
    mycon.commit()
    print("Book Added Successfully!\n")

def view_books():
    mycur.execute("SELECT * FROM books_details")
    print("\n ALL BOOKS:")
    for row in mycur.fetchall():
        print(row)

def search_book_by_id():
    bid = int(input("Enter Book ID to Search: "))
    mycur.execute("SELECT * FROM books_details WHERE bid=%s", (bid,))
    data = mycur.fetchone()
    if data:
        print("Book Found:", data)
    else:
        print(" Book not found!")

def search_book_by_name():
    name = input("Enter part of Book Title: ")
    mycur.execute("SELECT * FROM books_details WHERE title LIKE %s", ('%' + name                        + '%',))
    data = mycur.fetchall()
    if data:
        print(" Matching Books:")
        for row in data:
            print(row)
    else:
        print("No book found with that name.")

def update_book_shelf():
    bid = int(input("Enter Book ID to Update Shelf: "))
    shelf = input("Enter New Shelf: ")
    mycur.execute("UPDATE books_details SET shelf=%s WHERE bid=%s", (shelf, bid))
    mycon.commit()
    print(" Shelf Updated Successfully!\n")

def delete_book():
    bid = int(input("Enter Book ID to Delete: "))
    mycur.execute("DELETE FROM books_details WHERE bid=%s", (bid,))
    mycon.commit()
    print(" Book Deleted Successfully!\n")

