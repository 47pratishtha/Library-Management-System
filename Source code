def view_overdue_books():
    today=input("enter today's date:")
    mycur.execute("SELECT * FROM issue_details WHERE rdate < %s", (today,))
    data = mycur.fetchall()
    if data:
        print("\n OVERDUE BOOKS:")
        for row in data:
            print(row)
    else:
        print(" No overdue books.")

def calculate_fine():
    iid = int(input("Enter Issue ID: "))
    mycur.execute("SELECT rdate FROM issue_details WHERE iid = %s", (iid,))
    data = mycur.fetchone()
    if data:
        rdate = data[0]
        today = input("Enter today's date (YYYY-MM-DD): ")
        if today > str(rdate):
            days_late = int(input("Enter number of days late: "))
            fine = days_late * 5
            print("Fine = ₹", fine)
        else:
            print("No fine.")
    else:
        print("Invalid Issue ID!")

def fine_report():
    today = input("Enter today's date (YYYY-MM-DD): ")
    mycur.execute("SELECT rdate FROM issue_details WHERE rdate < %s", (today,))
    data = mycur.fetchone() 
    if data:
        print("There are pending fines.")
    else:
        print("No pending fines!")

def purchase_books():
    pid = int(input("Enter Purchase ID: "))
    bid = int(input("Enter Book ID: "))
    qty = int(input("Enter number of copies purchased: "))
    vendor = input("Enter Vendor Name: ")
    pdate = input("enter today's date:")

    mycur.execute("SELECT * FROM books_details WHERE bid=%s", (bid,))
    book = mycur.fetchone()
    if book:
        mycur.execute("UPDATE books_details SET total=total+%s, avail=avail+%s   WHERE bid=%s", (qty, qty, bid))
        mycon.commit()
        print(qty,"copies added to existing stock.")
    else:
        print(" Book not found! Add it first.")
        return

    mycur.execute("INSERT INTO purchases VALUES(%s,%s,%s,%s,%s)", (pid, bid, qty, pdate, vendor))
    mycon.commit()
    print("Purchase recorded successfully!\n")

